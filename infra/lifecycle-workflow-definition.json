{
  "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "NotificationUrl": {
      "type": "securestring"
    },
    "GraphSubscriptionClientState": {
      "type": "securestring"
    }
  },
  "triggers": {
    "Recurrence": {
      "type": "Recurrence",
      "recurrence": {
        "frequency": "Day",
        "interval": 1,
        "timeZone": "UTC"
      }
    }
  },
  "actions": {
    "List_subscriptions": {
      "type": "Http",
      "runtimeConfiguration": {
        "secureData": { "properties": ["inputs", "outputs"] }
      },
      "runAfter": {},
      "inputs": {
        "method": "GET",
        "uri": "https://graph.microsoft.com/beta/subscriptions",
        "authentication": {
          "type": "ManagedServiceIdentity",
          "audience": "https://graph.microsoft.com"
        }
      }
    },
    "Filter_callback_subscriptions": {
      "type": "Query",
      "runtimeConfiguration": {
        "secureData": { "properties": ["inputs", "outputs"] }
      },
      "runAfter": {
        "List_subscriptions": [
          "Succeeded"
        ]
      },
      "inputs": {
        "from": "@body('List_subscriptions')?['value']",
        "where": "@and(equals(item()?['changeType'], 'created'), or(equals(item()?['resource'], '/reports/healthmonitoring/alerts'), equals(item()?['resource'], 'reports/healthmonitoring/alerts')), equals(item()?['notificationUrl'], parameters('NotificationUrl')))"
      }
    },
    "Listing_is_ambiguous": {
      "type": "Compose",
      "runtimeConfiguration": {
        "secureData": { "properties": ["inputs"] }
      },
      "runAfter": {
        "Filter_callback_subscriptions": [
          "Succeeded"
        ]
      },
      "inputs": "@or(not(empty(body('List_subscriptions')?['@odata.nextLink'])), greater(length(body('Filter_callback_subscriptions')), 1))"
    },
    "Assert_subscription_ownership": {
      "type": "If",
      "runAfter": {
        "Listing_is_ambiguous": [
          "Succeeded"
        ]
      },
      "expression": "@equals(outputs('Listing_is_ambiguous'), true)",
      "actions": {
        "Stop_on_incomplete_or_mismatched_subscription": {
          "type": "Terminate",
          "inputs": {
            "runStatus": "Failed",
            "runError": {
              "code": "GraphSubscriptionOwnershipUnclear",
              "message": "The Graph subscription listing is incomplete or has multiple matches for this callback. Reconcile the exact subscription before renewing or creating one."
            }
          }
        }
      },
      "else": {
        "actions": {}
      }
    },
    "Has_callback_subscription": {
      "type": "Compose",
      "runtimeConfiguration": {
        "secureData": { "properties": ["inputs"] }
      },
      "runAfter": {
        "Assert_subscription_ownership": [
          "Succeeded"
        ]
      },
      "inputs": "@greater(length(body('Filter_callback_subscriptions')), 0)"
    },
    "Check_existing_subscription": {
      "type": "If",
      "runAfter": {
        "Has_callback_subscription": [
          "Succeeded"
        ]
      },
      "expression": {
        "equals": [
          "@outputs('Has_callback_subscription')",
          false
        ]
      },
      "actions": {
        "Create_subscription": {
          "type": "Http",
          "runtimeConfiguration": {
            "secureData": { "properties": ["inputs", "outputs"] }
          },
          "runAfter": {},
          "inputs": {
            "method": "POST",
            "uri": "https://graph.microsoft.com/beta/subscriptions",
            "body": {
              "changeType": "created",
              "notificationUrl": "@parameters('NotificationUrl')",
              "resource": "/reports/healthmonitoring/alerts",
              "expirationDateTime": "@{addMinutes(utcNow(), 42300)}",
              "clientState": "@parameters('GraphSubscriptionClientState')",
              "latestSupportedTlsVersion": "v1_2"
            },
            "authentication": {
              "type": "ManagedServiceIdentity",
              "audience": "https://graph.microsoft.com"
            }
          }
        }
      },
      "else": {
        "actions": {
          "Get_matching_subscription": {
            "type": "Compose",
            "runtimeConfiguration": {
              "secureData": { "properties": ["inputs"] }
            },
            "runAfter": {},
            "inputs": "@first(body('Filter_callback_subscriptions'))"
          },
          "Get_subscription_by_id": {
            "type": "Http",
            "runtimeConfiguration": {
              "secureData": { "properties": ["inputs", "outputs"] }
            },
            "runAfter": {
              "Get_matching_subscription": ["Succeeded"]
            },
            "inputs": {
              "method": "GET",
              "uri": "https://graph.microsoft.com/beta/subscriptions/@{outputs('Get_matching_subscription')?['id']}",
              "authentication": {
                "type": "ManagedServiceIdentity",
                "audience": "https://graph.microsoft.com"
              }
            }
          },
          "Verify_subscription_ownership": {
            "type": "Compose",
            "runtimeConfiguration": {
              "secureData": { "properties": ["inputs"] }
            },
            "runAfter": {
              "Get_subscription_by_id": [
                "Succeeded"
              ]
            },
            "inputs": "@and(equals(body('Get_subscription_by_id')?['id'], outputs('Get_matching_subscription')?['id']), equals(body('Get_subscription_by_id')?['notificationUrl'], parameters('NotificationUrl')), equals(body('Get_subscription_by_id')?['changeType'], 'created'), or(equals(body('Get_subscription_by_id')?['resource'], '/reports/healthmonitoring/alerts'), equals(body('Get_subscription_by_id')?['resource'], 'reports/healthmonitoring/alerts')), equals(body('Get_subscription_by_id')?['clientState'], parameters('GraphSubscriptionClientState')))"
          },
          "Stop_on_subscription_mismatch": {
            "type": "If",
            "runAfter": {
              "Verify_subscription_ownership": [
                "Succeeded"
              ]
            },
            "expression": "@equals(outputs('Verify_subscription_ownership'), false)",
            "actions": {
              "Fail_on_subscription_mismatch": {
                "type": "Terminate",
                "inputs": {
                  "runStatus": "Failed",
                  "runError": {
                    "code": "GraphSubscriptionOwnershipMismatch",
                    "message": "The exact subscription does not match this workflow's callback and clientState. Reconcile it before renewal."
                  }
                }
              }
            },
            "else": { "actions": {} }
          },
          "Compose_expiration": {
            "type": "Compose",
            "runAfter": {
              "Stop_on_subscription_mismatch": [
                "Succeeded"
              ]
            },
            "inputs": "@body('Get_subscription_by_id')?['expirationDateTime']"
          },
          "Check_expiring_soon": {
            "type": "If",
            "runAfter": {
              "Compose_expiration": [
                "Succeeded"
              ]
            },
            "expression": {
              "lessOrEquals": [
                "@ticks(outputs('Compose_expiration'))",
                "@ticks(addDays(utcNow(), 10))"
              ]
            },
            "actions": {
              "Reauthorize_subscription": {
                "type": "Http",
                "runAfter": {},
                "inputs": {
                  "method": "POST",
                  "uri": "https://graph.microsoft.com/beta/subscriptions/@{outputs('Get_matching_subscription')?['id']}/reauthorize",
                  "authentication": {
                    "type": "ManagedServiceIdentity",
                    "audience": "https://graph.microsoft.com"
                  }
                }
              },
              "Renew_subscription": {
                "type": "Http",
                "runAfter": {
                  "Reauthorize_subscription": [
                    "Succeeded",
                    "Failed"
                  ]
                },
                "inputs": {
                  "method": "PATCH",
                  "uri": "https://graph.microsoft.com/beta/subscriptions/@{outputs('Get_matching_subscription')?['id']}",
                  "body": {
                    "expirationDateTime": "@{addMinutes(utcNow(), 42300)}"
                  },
                  "authentication": {
                    "type": "ManagedServiceIdentity",
                    "audience": "https://graph.microsoft.com"
                  }
                }
              },
                    "Check_warning_window": {
                      "type": "If",
                      "runAfter": {
                        "Renew_subscription": [
                    "Failed"
                  ]
                },
                "expression": {
                  "lessOrEquals": [
                    "@ticks(outputs('Compose_expiration'))",
                    "@ticks(addDays(utcNow(), 7))"
                  ]
                      },
                      "actions": {
                        "Relay_lifecycle_warning": {
                          "type": "Http",
                          "runtimeConfiguration": {
                            "secureData": { "properties": ["inputs", "outputs"] }
                          },
                          "runAfter": {},
                          "inputs": {
                            "method": "POST",
                            "uri": "@parameters('NotificationUrl')",
                            "body": {
                              "internalMessage": {
                                "clientState": "@parameters('GraphSubscriptionClientState')",
                                "messageBody": "@concat('<p class=\"editor-paragraph\"><strong>Microsoft Entra Health subscription renewal failed</strong></p><p class=\"editor-paragraph\">Subscription ', outputs('Get_matching_subscription')?['id'], ' expires at ', outputs('Compose_expiration'), ' UTC. Review Logic App lifecycle workflow permissions and rerun provisioning if needed.</p>')"
                              }
                            }
                          }
                        }
                },
                "else": {
                  "actions": {}
                }
              }
            },
            "else": {
              "actions": {}
            }
          }
        }
      }
    }
  },
  "outputs": {}
}
